# .clang-tidy
# 命名规则依据 references/OpenHarmony-cpp-coding-style-guide.md 第 2 章
---
# opt-in 的字节填充优化检查在此排除：HdrConfig 等配置结构按功能分组排列字段以便阅读，
# 只在启动时构造一次、不在热点路径上。NOLINTNEXTLINE 对 clang-analyzer 检查无效，
# 只能整体排除，否则 CI 的 clang-analyzer 硬门禁会失败。
# performance-avoid-endl 同样排除：它不在 OpenHarmony 规范条目内，风格指南自身示例
# （规则 5.x 的 cout 输出示例）就在使用 std::endl；且 endl 附带 flush 语义，
# 机械替换为 '\n' 会改变日志刷盘时机，不是纯风格问题，故不作为门禁项。
# 注意：Checks 是 YAML 块标量，块内 '#' 不是注释而是内容，故说明性文字一律写在块外，
# 否则会与下一行条目粘连成非法 glob，导致该条目静默失效。
Checks: >
  -*,
  bugprone-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  readability-*,
  clang-analyzer-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers,
  -readability-identifier-length,
  -performance-avoid-endl,
  -clang-analyzer-optin.performance.Padding

WarningsAsErrors: ''
# 只检查本工程目录下的头文件；_deps/ 与 third_party/ 不在这些前缀下，自然被排除。
# 注意：LLVM 的 llvm::Regex 不支持负向先行断言 (?!...)，原先的
# '^(?!.*(third_party|\.cpm-cache)).*$' 永远匹配失败，导致头文件从未被检查。
# 另外该正则是对绝对路径做部分匹配，不能用 ^ 锚定工程根。
HeaderFilterRegex: '(src|inc|tests)[\\/]'
FormatStyle: file

CheckOptions:
  # 类型与作用域名：大驼峰（规则 2.1）
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.UnionCase
    value: CamelCase
  - key: readability-identifier-naming.NamespaceCase
    value: CamelCase
  - key: readability-identifier-naming.TypedefCase
    value: CamelCase

  # 函数：大驼峰（规则 2.1）
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase

  # 变量：小驼峰（规则 2.5）
  - key: readability-identifier-naming.VariableCase
    value: camelBack
  - key: readability-identifier-naming.ParameterCase
    value: camelBack

  # 类成员变量：小驼峰 + 后下划线（规则 2.5.2）
  - key: readability-identifier-naming.PrivateMemberCase
    value: camelBack
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: '_'
  - key: readability-identifier-naming.ProtectedMemberCase
    value: camelBack
  - key: readability-identifier-naming.ProtectedMemberSuffix
    value: '_'
  # 规则 2.5.2 明确豁免 struct/union 的成员变量（保持小驼峰、不加后缀），
  # 但 clang-tidy 的 PublicMember* 同时覆盖 class 与 struct 的公有成员，
  # 没有 StructMember* 之类的独立选项可以区分。因此这里只约束命名风格、
  # 不约束后缀：否则 HdrConfig、Params 等聚合体的每个字段都会被误报。
  # class 的成员仍由 PrivateMemberSuffix 强制加下划线。
  - key: readability-identifier-naming.PublicMemberCase
    value: camelBack

  # 全局变量：g_ 前缀（规则 2.5.1）
  - key: readability-identifier-naming.GlobalVariableCase
    value: camelBack
  - key: readability-identifier-naming.GlobalVariablePrefix
    value: 'g_'

  # 常量（规则 2.6）：
  #   全局作用域 / 类的静态成员常量 -> 全大写 + 下划线
  #   函数局部 const 常量、类的普通 const 成员变量 -> 小驼峰
  # ConstantCase 是兜底项，按规范取小驼峰，不要设成 UPPER_CASE，
  # 否则会把函数局部常量与普通 const 成员误判为违规。
  - key: readability-identifier-naming.ConstantCase
    value: camelBack
  # const 的类成员变量（如 capacity_、numThreads_）会同时命中 Constant 规则与
  # 成员后缀规则：成员规则要求带后下划线，而 camelBack 不接受尾随下划线，两条规则
  # 互斥。这里让 Constant 规则放过带下划线后缀的名字，交给成员规则校验。
  - key: readability-identifier-naming.ConstantIgnoredRegexp
    value: '.*_$'
  - key: readability-identifier-naming.LocalConstantCase
    value: camelBack
  - key: readability-identifier-naming.GlobalConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.ClassConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.EnumConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  # 双下划线开头是编译器/标准库保留标识符，项目里只用于探测内建宏是否存在，
  # 不是本工程自定义的宏，不应纳入命名规范。
  - key: readability-identifier-naming.MacroDefinitionIgnoredRegexp
    value: '^__.*$'
  # nlohmann::json 通过 ADL 查找这两个名字作为序列化钩子，改名会直接破坏序列化，
  # 属于外部约定，不可按本工程命名规范改名。
  - key: readability-identifier-naming.FunctionIgnoredRegexp
    value: '^(to_json|from_json)$'
  # 类的静态数据成员带后下划线时，clang-tidy 仍会按全局变量规则（要求 g_ 前缀）报错。
  # 这种情况应归成员规则管，放过带后缀的名字，避免误加 g_ 前缀。
  - key: readability-identifier-naming.GlobalVariableIgnoredRegexp
    value: '.*_$'
  # begin/end 是标准容器迭代接口的约定名（range-for、std::begin 依赖），
  # 属于语言/库协议，不可改名。
  - key: readability-identifier-naming.ClassConstantIgnoredRegexp
    value: '^(begin|end)$'

  - key: modernize-use-nullptr.NullMacros
    value: 'NULL'
